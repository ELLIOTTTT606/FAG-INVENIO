# ═══════════════════════════════════════════════════════════════
# INVENIO — Variables d'environnement de production
# Copier vers .env et remplir toutes les valeurs
# NE JAMAIS committer ce fichier (.gitignore déjà configuré)
# ═══════════════════════════════════════════════════════════════

# ── Domaine & SSL ───────────────────────────────────────────────
# Votre sous-domaine DuckDNS (créez-en un sur duckdns.org)
DOMAIN=invenio-fa.duckdns.org

# Token DuckDNS (visible sur duckdns.org après connexion)
DUCKDNS_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Base de données (PostgreSQL partagé) ────────────────────────
DB_USER=invenio
# Choisissez un mot de passe fort (min 20 caractères recommandés)
DB_PASSWORD=CHANGEZ_MOI_mot_de_passe_fort_ici

# ── Sécurité ────────────────────────────────────────────────────
# Clé secrète partagée (générez avec: openssl rand -hex 32)
SECRET_KEY=CHANGEZ_MOI_cle_secrete_generee_avec_openssl

# ── NocoDB ──────────────────────────────────────────────────────
# Token API NocoDB (généré depuis l'UI NocoDB après installation)
# Accès : http://localhost:8080 via SSH tunnel → Team & Auth → API Tokens
NOCODB_TOKEN=
NOCODB_URL=http://nocodb:8080

# IDs des tables NocoDB (remplis après migration depuis Baserow)
# Visibles dans NocoDB : URL de la table → identifiant md_xxx...
NOCODB_TABLE_CLIENTS=
NOCODB_TABLE_CONTACTS_FORCE_VENTE=
NOCODB_TABLE_CONTACTS_SOLUTION=
NOCODB_TABLE_OPTIONS_ACCESSOIRES=
NOCODB_TABLE_PRIX_MACHINES=

# ── Baserow (à conserver pendant la migration) ──────────────────
# Laissez ces valeurs pendant la période de transition.
# Supprimez-les une fois NocoDB pleinement opérationnel.
BASEROW_URL=https://api.baserow.io
BASEROW_TOKEN=
BASEROW_TABLE_CLIENTS=939119
BASEROW_TABLE_CONTACTS_FORCE_VENTE=939355
BASEROW_TABLE_CONTACTS_SOLUTION=939361
BASEROW_TABLE_OPTIONS_ACCESSOIRES=941070

# ── Ollama (IA locale) ──────────────────────────────────────────
OLLAMA_URL=http://ollama:11434
# Modèle recommandé : mistral (bon français technique) ou llama3.2
OLLAMA_MODEL=mistral

# ── Application ─────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO
