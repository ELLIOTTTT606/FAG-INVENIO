{
  "buildCommand": "cd ui && npm install && npm run build",
  "outputDirectory": "ui/dist",
  "installCommand": "pip install fastapi uvicorn pydantic pydantic-settings python-docx pdfplumber jsonschema rapidfuzz pandas httpx python-multipart jinja2",
  "rewrites": [
    { "source": "/health", "destination": "/api/index" },
    { "source": "/admin/(.*)", "destination": "/api/index" },
    { "source": "/contacts/(.*)", "destination": "/api/index" },
    { "source": "/options(.*)", "destination": "/api/index" },
    { "source": "/clients(.*)", "destination": "/api/index" },
    { "source": "/parse/(.*)", "destination": "/api/index" },
    { "source": "/generate/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.py": {
      "runtime": "python3.11"
    }
  }
}
